# Supabase — preencha com os valores do projeto que voce criou no dashboard.
# Copie este arquivo para .env.local (que NAO vai pro git) e preencha:
#   cp .env.local.example .env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Project ID (apenas referencia, nao usado em runtime)
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Service role key (SECRETA, NUNCA prefixar com NEXT_PUBLIC).
# Necessaria para:
#  - Script `pnpm seed:admin` (criar usuario admin inicial)
#  - Convidar pesquisadores pela tela /admin/pesquisadores
#
# Onde obter: Dashboard Supabase -> Project Settings -> API -> service_role (secret) -> Reveal
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publica do app (usada nos links dos emails de convite).
# Dev: porta 3030 (fixada para evitar conflito com outros Next em :3000/:3001)
# Em prod: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# ============================================================
# Bot do Telegram (preenche seguimentos a partir de PDFs de exame)
# ============================================================
# 1. Crie o bot com o @BotFather (/newbot) e cole o token aqui.
TELEGRAM_BOT_TOKEN=
# 2. Segredo do webhook (gere um aleatório, ex.: `openssl rand -hex 32`).
#    Use o MESMO valor ao registrar o webhook no setWebhook (secret_token).
TELEGRAM_WEBHOOK_SECRET=
# 3. IDs numéricos do Telegram autorizados a usar o bot, separados por vírgula.
#    Pegue o seu em @userinfobot. Sem isso, ninguém consegue usar o bot.
TELEGRAM_ALLOWED_USER_IDS=

# ============================================================
# Sentry (opcional — sem isso, nada de error monitoring)
# ============================================================
# Como configurar:
# 1. Crie conta gratuita em https://sentry.io (free tier: 5k events/mes)
# 2. Crie projeto Next.js -> copie DSN (Settings -> Client Keys (DSN))
# 3. No Vercel: Settings -> Environment Variables, cole os 4 abaixo
#
# Em dev local, deixe vazio -> Sentry vira no-op (nao envia nada).
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload (so roda em build do Vercel quando o token esta setado):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
